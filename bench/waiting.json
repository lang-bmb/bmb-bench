{
  "_about": "What waits for the measurement machine, in the order of the priorities of lang-bmb's docs/ROADMAP.md. The `task` of an entry is the label the run was queued under. `like` names committed result files of the same kind of run; a run's tokens are estimated as their mean. `proxy` says those files are another set or surface, not this one.",
  "entries": [
    {"task": "T0-08", "tier": "critical path (gate B)", "runs": [
      {"what": "brb-hard BMB arm, 3 repeats", "model": "qwen", "times": 1, "like": ["bench/brb-hard/results/*-qwen-r*-bmb.jsonl"]},
      {"what": "brb-hard Rust arm, 3 repeats", "model": "qwen", "times": 1, "like": ["bench/brb-hard/results/*-qwen-r*-rust.jsonl"]}
    ]},
    {"task": "2A-14e", "tier": "critical path (gate B)", "runs": [
      {"what": "BCB N=1,000 (no model, CPU)", "model": "-", "times": 1, "cpu": true}
    ]},
    {"task": "T1-41", "tier": "critical path (gate B)", "runs": [
      {"what": "m1b-diff", "model": "qwen", "times": 1, "like": ["bench/m1b-write/results/*qwen*.jsonl"], "proxy": "m1b-write"},
      {"what": "m1b-ast", "model": "qwen", "times": 1, "like": ["bench/m1b-write/results/*qwen*.jsonl"], "proxy": "m1b-write"},
      {"what": "bvb-diff", "model": "qwen", "times": 1, "like": ["bench/bvb-write/results/*qwen*.jsonl"], "proxy": "bvb-write"},
      {"what": "bvb-ast", "model": "qwen", "times": 1, "like": ["bench/bvb-write/results/*qwen*.jsonl"], "proxy": "bvb-write"},
      {"what": "brb-diff", "model": "qwen", "times": 1, "like": ["bench/brb-write/results/*qwen*-bmb.jsonl"], "proxy": "brb-write"},
      {"what": "brb-ast", "model": "qwen", "times": 1, "like": ["bench/brb-write/results/*qwen*-bmb.jsonl"], "proxy": "brb-write"}
    ]},
    {"task": "T0-41", "tier": "quality of the gate B verdict", "runs": [
      {"what": "m1b-write repeats 2 to 4", "model": "sonnet", "times": 3, "like": ["bench/m1b-write/results/*sonnet*.jsonl"]}
    ]},
    {"task": "T0-33", "tier": "quality of the gate B verdict", "runs": [
      {"what": "bvb-write repeats 2 to 5", "model": "qwen", "times": 4, "like": ["bench/bvb-write/results/*qwen*.jsonl"]},
      {"what": "brb-write repeats 1 to 5", "model": "qwen", "times": 5, "like": ["bench/brb-write/results/*qwen*-bmb.jsonl"]},
      {"what": "bvb repeats 1 to 5", "model": "qwen", "times": 5, "like": ["bench/bvb/results/*-qwen3.8-27b.jsonl"]},
      {"what": "brb BMB arm repeats 1 to 5", "model": "qwen", "times": 5, "like": ["bench/brb/results/*qwen*-bmb.jsonl"]}
    ]},
    {"task": "T0-37", "tier": "moderating hypotheses", "runs": [
      {"what": "bvb-write original (same commit)", "model": "qwen", "times": 1, "like": ["bench/bvb-write/results/*qwen*.jsonl"]},
      {"what": "bvb-write-{undecided,probe,stateless}", "model": "qwen", "times": 3, "like": ["bench/bvb-write/results/*qwen*.jsonl"], "proxy": "bvb-write"},
      {"what": "brb-write original (same commit)", "model": "qwen", "times": 1, "like": ["bench/brb-write/results/*qwen*-bmb.jsonl"]},
      {"what": "brb-write-{undecided,probe,stateless}", "model": "qwen", "times": 3, "like": ["bench/brb-write/results/*qwen*-bmb.jsonl"], "proxy": "brb-write"}
    ]},
    {"task": "2D-39", "tier": "moderating hypotheses", "runs": [
      {"what": "BNB N=10,000 original and windows 16K, 32K", "model": "qwen", "times": 3, "like": ["bench/bnb/results/3a06/qwen-bmb-10k*.jsonl"], "proxy": "the BNB original"},
      {"what": "BNB N=10,000 original and windows 16K, 32K", "model": "sonnet", "times": 3, "like": ["bench/bnb/results/3a06/sonnet-bmb-10k*.jsonl"], "proxy": "the BNB original"}
    ]},
    {"task": "T0-17", "tier": "moderating hypotheses", "runs": [
      {"what": "m1b-write-lean, bvb-write-lean", "model": "qwen", "times": 1, "like": ["bench/m1b-write/results/*qwen*.jsonl", "bench/bvb-write/results/2026-11-02-qwen*.jsonl"], "sum": true, "proxy": "the originals"},
      {"what": "m1b-write-lean, bvb-write-lean", "model": "sonnet", "times": 1, "like": ["bench/m1b-write/results/*sonnet*.jsonl", "bench/bvb-write/results/*sonnet*.jsonl"], "sum": true, "proxy": "the originals"}
    ]},
    {"task": "T0-15", "tier": "moderating hypotheses", "runs": [
      {"what": "m1b-write-compact, bvb-write-compact and the originals", "model": "qwen", "times": 2, "like": ["bench/m1b-write/results/*qwen*.jsonl", "bench/bvb-write/results/2026-11-02-qwen*.jsonl"], "sum": true, "proxy": "the originals"},
      {"what": "m1b-write-compact, bvb-write-compact and the originals", "model": "sonnet", "times": 2, "like": ["bench/m1b-write/results/*sonnet*.jsonl", "bench/bvb-write/results/*sonnet*.jsonl"], "sum": true, "proxy": "the originals"}
    ]},
    {"task": "T1-44", "tier": "auxiliary hypotheses", "runs": [
      {"what": "bench/review, both arms (143 changes)", "model": "qwen", "times": 1},
      {"what": "bench/review, both arms (143 changes)", "model": "sonnet", "times": 1},
      {"what": "bench/intent, both arms (90 items)", "model": "qwen", "times": 1},
      {"what": "bench/intent, both arms (90 items)", "model": "sonnet", "times": 1}
    ]}
  ]
}
