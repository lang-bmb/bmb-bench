#[summary("bench: std::sha256::digest over 16 MiB of pseudo-random bytes, 8 times (the first byte changes each time). The twin is sha256_speed.rs (Rust of the same algorithm: the same code as compiler/src/sha256.rs, standard library only)")]
mod app {
    spec fn size_ok(n: usize) -> bool { 0 < n && n <= 16777216 }

    spec fn exactly(v: &[u8], n: usize) -> bool { v.len() == n }

    // `n` deterministic bytes: the high bits of a 64-bit LCG.
    #[effects(alloc)]
    #[uses(size_ok, exactly)]
    fn data(n: usize) -> (r: Vec<u8>)
        requires size_ok(n),
        ensures exactly(r.as_slice(), n),
    {
        let mut v: Vec<u8> = Vec::with_capacity(n);
        let mut x: u64 = 12345;
        for i in 0..n
            invariant exactly(v.as_slice(), i),
        {
            x = x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
            v.push((x >> 56) as u8);
        }
        v
    }

    #[effects(alloc, io)]
    #[uses(size_ok, exactly, std::sha256::msg_ok)]
    fn main() -> () {
        let n: usize = 16777216;
        let mut v: Vec<u8> = data(n);
        let mut acc: u64 = 0;
        let times: usize = 8;
        let width: usize = 32;
        for k in 0..times
            invariant exactly(v.as_slice(), n),
        {
            v[0] = k as u8;
            let d: [u8; 32] = std::sha256::digest(v.as_slice());
            for j in 0..width {
                acc = acc.wrapping_mul(31).wrapping_add(d[j] as u64);
            }
        }
        print_u64(acc);
    }
}
